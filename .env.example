# =============================================================
# Copy this file to `.env` and fill in your own credentials.
# `.env` is git-ignored.
# =============================================================

# ---- Azure OpenAI (LLM) ----
AZURE_OPENAI_API_KEY=sk-your-azure-openai-key-here
AZURE_ENDPOINT=https://your-azure-endpoint.azure-api.net/
AZURE_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_API_VERSION=2025-02-01-preview
LLM_TIMEOUT=30

# ---- TTS engine selection ----
# Options: edge | cosyvoice | xtts | gpt_sovits
TTS_ENGINE=cosyvoice

# ---- Aliyun DashScope CosyVoice (cloud TTS, recommended) ----
DASHSCOPE_API_KEY=sk-your-dashscope-key-here
THA_COSYVOICE_MODEL=cosyvoice-v3.5-plus
THA_COSYVOICE_VOICE=cosyvoice-v3.5-plus-bailian-ec8e67bf91fb4b78932c218ddea392f9
THA_COSYVOICE_FORMAT=wav
THA_COSYVOICE_SR=22050

# ---- XTTS / GPT-SoVITS (optional, local voice-cloning engines) ----
XTTS_REFERENCE_WAV=data/voice/keqing.wav
GPT_SOVITS_REFERENCE_WAV=data/voice/keqing.wav
GPT_SOVITS_API_URL=http://127.0.0.1:9880/tts

# ---- WhisperX device override (optional) ----
# Set to "cpu" to keep the GPU free for THA3 rendering when VRAM is tight.
# WHISPERX_DEVICE=cuda

# ---- THA3 input mode default ----
# text | mic
THA_INPUT_MODE=text
